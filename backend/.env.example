# --- Base de datos local (desarrollo) ---
DB_NAME=simulacros_db
DB_USER=postgres
DB_PASSWORD=TuPassword
DB_HOST=localhost
DB_PORT=5432

# --- Producción (Render/Neon): definir solo esta y omitir las de arriba ---
